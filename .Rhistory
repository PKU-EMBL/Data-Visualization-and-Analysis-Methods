aes(x = Province, y = 40, label = Province),  # 在 y=0 处放置标签
inherit.aes = FALSE,  # 不继承 fill 等属性
vjust = 1.0,          # 调整垂直位置（值越大越靠下）
angle = 45,           # 倾斜0度避免重叠
size = 2.5,
color = "black"
) +
geom_text(
aes(label = sprintf("%.1f", GWP)),
hjust = 0.5, vjust = 1.5, size = 2.1, color = "black" # 数值标签保持在柱子顶部
) +
labs(
title = "Environmental Impact of Direct-Fired Power Generation in Different Provinces",
x = NULL,
y = expression("Environmental Impact (kgCO"[2]*"eq)"),
caption = "注：负值表示碳汇/减排效果"
) +
theme_minimal() +
theme(
axis.text.x = element_blank(),  # 隐藏默认的 x 轴标签
axis.ticks.length.x = unit(0.5, "cm"),  # 延长x轴刻度线
plot.title = element_text(hjust = 0.5, face = "bold"),
panel.grid = element_blank(),
panel.border = element_rect(colour = "black", fill = NA, linewidth = 1),
panel.grid.major.x = element_blank()
)
print(p8)
